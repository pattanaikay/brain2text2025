flowchart LR
    subgraph WAKE["WAKE — single forward pass · latency independent of N"]
      direction TB
      NI["neural (T,512)"]:::w --> RI["read_in[session]"]:::w --> PE["patch embed<br/>LN1 → Linear → LN2"]:::tgt --> TF["7× RoPE Transformer (frozen)"]:::fz --> EM["episodic memory read<br/>cross-attn + gated fuse"]:::mem --> HD["CTC head 384→42 (frozen)"]:::fz --> PH["phonemes → words (lexicon DP)"]:::w
    end

    subgraph SLEEP["SLEEP — offline, between trials · cost ≈ linear in N"]
      direction TB
      PL["pseudo_label<br/>self | lm | oracle"]:::s --> AUG["64 time-masked augs (~53%)"]:::s --> LOOP["for n in 1..N:<br/>loss = CTC + MSE(latent, recalled)<br/>AdamW step"]:::loop --> WR["confidence-gated write<br/>to episodic memory"]:::mem
    end

    PH -. "trial ends → enter sleep" .-> PL
    RP["ReplayStore<br/>priority = |surprise|<br/>+ (1−conf) + novelty"]:::rep --> LOOP
    WR --> RP
    LOOP == "updates ONLY<br/>patch-embed + read-in" ==> PE

